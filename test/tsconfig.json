{
    "compilerOptions": {
        "target": "es2020",
        "experimentalDecorators": true,
        "skipLibCheck": true,
        "noImplicitAny": false,
        "module": "commonjs",
        "moduleResolution": "node",
        "declaration": true,
        "sourceMap": true,
        "alwaysStrict": true,
        "outDir": "dist/",
        "typeRoots": [
            "../node_modules/@types"
        ],
        "lib": [
            "es2020",
            "dom"
        ]
    },
    "include": [
        "index.d.ts",
        "spec/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
