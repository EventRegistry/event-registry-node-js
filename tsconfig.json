{
    "compilerOptions": {
        "target": "ES2020",
        "experimentalDecorators": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "strict": true,
        "moduleResolution": "node16",
        "declaration": true,
        "sourceMap": true,
        "alwaysStrict": true,
        "outDir": "dist/",
        "typeRoots": [
            "node_modules/@types"
        ],
        "lib": [
            "ES2020"
        ]
    },
    "include": [
        "src/index.ts",
        "src/version.ts",
        "src/mutex.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}
